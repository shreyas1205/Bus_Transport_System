DATABASE_URL="postgresql://campus:campus_dev@localhost:5432/campus_bus?schema=public"
JWT_SECRET="replace-with-a-random-jwt-secret-at-least-32-characters-long"
OTP_SECRET="replace-with-a-different-random-otp-secret-at-least-32-characters"
PORT=4000
FRONTEND_URL="http://localhost:5173"

# Optional Razorpay test mode
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""

# Email OTP / reports
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""
REPORT_EMAIL="admin@college.edu"

# Optional SMS OTP (Twilio)
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""
TWILIO_MESSAGING_SERVICE_SID=""

# Autonomous accident response
AUTONOMOUS_DISPATCH_ENABLED="true"
AUTONOMOUS_DISPATCH_CONFIDENCE="0.80"
EMERGENCY_RESOURCE_RADIUS_METERS="12000"
EMERGENCY_LOOKUP_TIMEOUT_MS="7000"
OVERPASS_URL="https://overpass-api.de/api/interpreter"

# demo = nearby police/hospital selection + simulated distress delivery
# webhook = deliver the distress packet to an authorized dispatcher/integration
EMERGENCY_DISPATCH_MODE="demo"
EMERGENCY_DISPATCH_WEBHOOK_URL=""
EMERGENCY_DISPATCH_WEBHOOK_TOKEN=""

# Live journey safety thresholds
GPS_STALE_SECONDS="90"
ROUTE_DEVIATION_METERS="350"
CAMPUS_SECURITY_PHONE=""
TRANSPORT_EMERGENCY_PHONE=""
